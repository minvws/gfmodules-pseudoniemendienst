[app]
loglevel=debug
# Enable the /test routes
enable_test_routes=True
# Enable the exchange service routes (/exchange/*)
enable_exchange_services_routes=True
# Enable the mock SAML exchange routes (/saml-exchange/*); test environments only
enable_saml_exchange_routes=False

[logging]
# Single syslog channel (host:port, UDP); leave empty to log to stdout only.
# All streams (app, siem, public_inspect, debug) are multiplexed over this
# channel; each JSON record carries a stream_id field to tell them apart.
syslog_path=
# Identifies this application in the JSON records (application_id field),
# so the log server can tell apart applications sharing the channel.
application_id=pseudoniemendienst
# Emit an access record per request.
access_logs=True
# Include stack traces in the JSON logs
include_traces=True
# Log everything as plain text to the console (for local development)
console_streams=debug
# Log an error when a request arrives without an X-GF-Correlation-ID header
correlation_id_expected=False

[database]
dsn=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
retry_backoff=0.1, 0.2, 0.4, 0.8, 1.6, 3.2, 4.8, 6.4, 10.0
pool_size=5
max_overflow=10
pool_pre_ping=False
pool_recycle=1800

[uvicorn]
swagger_enabled = True
# If set to true, swagger will show fields to provide x-gf headers
# Should be disabled on production, this is not an security risk because
# x-gf headers are stripped by the gateway
document_gf_headers = True
docs_url = /docs
redoc_url = /redocs
host = 0.0.0.0
port = 6502
reload = True

use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key
# The root path if behind a proxy
root_path =

[hsm]
# When url is set HSM is used instead of the local keys
# url=https://localhost:8443
# module=softhsm
# slot=SoftHSMLabel
# timeout=10
# cert_file=secrets/prs-use.crt
# key_file=secrets/prs-use.key
# ca_cert_file=secrets/hsm-ca.crt

[local_keys]
# Keys for dev and testing, used when [hsm] url is not set
# Master key for hkdf
master_key=
# File with base64 OPRF server key
oprf_server_key_file=secrets/oprf-server.key

[saml_service]
# Base URL of the internal PRS-SAML service; required when enable_saml_exchange_routes is set
url=http://localhost:8504
timeout=5
# Leave mTLS unset for plain HTTP in local development.
# cert_file=secrets/prs-saml/client.crt
# key_file=secrets/prs-saml/client.key
# ca_cert_file=secrets/prs-saml/ca.crt

[authorization_headers]
# space separated list of expected audiences, one should be present in the authorization authorization header
# usually the value is the domain of the running application
expected_audiences = https://localhost:6502

[jwks]
# comma separated field for singing certificates path
signing_key_files = /secrets/signing_certificate_1.crt, /secrets/signing_certificate_2.crt
#
# comma separated field for active signing certificates
 active_signing_key_files = /secrets/test_signing_certificate_1.crt
#
# comma separated fields for hsm labels
hsm_key_labels =
# comma separated fields for active hsm labels
active_hsm_key_labels =
